# ─────────────────────────────────────────────────────────────────────────────
# VoC Engine — Environment Variables (example)
# Copy this file to .env and fill in your values.
# NEVER paste real secrets into this file — it is committed to GitHub.
# ─────────────────────────────────────────────────────────────────────────────

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=your-connection-string-here
AZURE_STORAGE_CONTAINER_NAME=voc-engine

# Azure Container Registry
AZURE_REGISTRY_URL=yourregistry.azurecr.io
AZURE_REGISTRY_USERNAME=your-acr-username
AZURE_REGISTRY_PASSWORD=your-acr-password

# PostgreSQL (Azure Database for PostgreSQL — staging only)
POSTGRES_HOST=your-db.postgres.database.azure.com
POSTGRES_DB=voc_engine
POSTGRES_USER=voc
POSTGRES_PASSWORD=your-password

# Redis (Azure Cache for Redis — staging only)
REDIS_URL=your-cache.redis.cache.windows.net:6380,password=xxx,ssl=True

# NLP
MODEL_PATH=mock
